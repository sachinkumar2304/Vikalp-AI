# Environment Variables — Vikalp AI (Prototype)
# Copy this file to .env in the respective service directory.
# NEVER commit real credentials to version control.

# ── BACKEND (backend/.env) ──────────────────────────────

# Application
APP_NAME=Vikalp_AI
APP_VERSION=1.0.0
DEBUG=False
HOST=0.0.0.0
PORT=8000

# Auth / JWT
SECRET_KEY=your-secret-key-here-use-openssl-rand-hex-32
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Supabase (Used by legacy LMS modules — not required for PM-AJAY core)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-supabase-anon-key
SUPABASE_SERVICE_KEY=your-supabase-service-role-key

# Community Supabase (Legacy — not required for PM-AJAY)
COMMUNITY_SUPABASE_URL=https://your-community-project.supabase.co
COMMUNITY_SUPABASE_KEY=your-community-anon-key

# Cloudinary (Used by legacy video modules — not required for PM-AJAY core)
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# ── FRONTEND (frontend/.env.local) ──────────────────────

# For local development — override with production URL on Vercel dashboard
VITE_API_BASE_URL=http://localhost:8000/api/v1

# ── PRODUCTION ONLY (Set in Render & Vercel dashboard — do not put here) ───
# VITE_API_BASE_URL=https://your-render-app.onrender.com/api/v1
