# Vikalp AI — Frontend Environment Variables
# Copy this to .env.local for local development
# Set VITE_API_BASE_URL on Vercel dashboard for production

# Local development
VITE_API_BASE_URL=http://localhost:8000/api/v1

# Production (uncomment and set your Render backend URL after deploying backend)
# VITE_API_BASE_URL=https://YOUR-RENDER-APP.onrender.com/api/v1
